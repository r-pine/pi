# Understory LLM config — copy to project root as .env.understory (gitignored).
# Required for memory_query / memory_add MCP tools to work.

UNDERSTORY_PORT=3800

# Primary model (OpenAI-compatible or Anthropic-compatible)
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_FORMAT=openai
LLM_MODEL=

# Optional fallback when primary fails (timeout, 5xx)
# LLM_FALLBACK_API_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_API_FORMAT=openai
# LLM_FALLBACK_MODEL=

# Optional: require Bearer token on /mcp and /api (recommended if not localhost)
# AUTH_TOKEN=

# GIT_AUTOCOMMIT=false
